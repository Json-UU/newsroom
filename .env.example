# Local settings, loaded automatically. start.bat copies this to .env.
# Only MARIADB_PASSWORD normally needs changing.

# Your MariaDB login. The database is created automatically on first run.
MARIADB_USER=root
MARIADB_PASSWORD=your-mariadb-root-password
MARIADB_DATABASE=newsroom
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306

# Development mode. Secret and approval keys are generated automatically.
DJANGO_DEBUG=1

# Optional: use SQLite instead of MariaDB (the brief requires MariaDB).
# DJANGO_USE_SQLITE=1

# Optional: a portable MariaDB that run.py starts if it is not running.
# MARIADB_SERVER=C:/path/to/mariadbd.exe
# MARIADB_CONFIG=C:/path/to/my.ini

# Optional overrides for the default logins (see README.md).
# DJANGO_ADMIN_PASSWORD=
# NEWSROOM_DEMO_PASSWORD=
